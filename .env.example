# ConnectHub Backend Environment Variables
# Copy this file to .env and fill in the values

# App Settings
APP_NAME="ConnectHub API"
APP_VERSION="0.1.0"
DEBUG=true
ENVIRONMENT="development"

# Supabase Settings (Required)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database (Optional - for direct PostgreSQL connection)
# DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# Redis (for ARQ background jobs)
REDIS_URL="redis://localhost:6379"

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Discovery Settings
DEFAULT_DISCOVERY_RADIUS_KM=50
MAX_DISCOVERY_RADIUS_KM=200
DISCOVERY_BATCH_SIZE=20
